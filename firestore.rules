rules_version = '2';

// AlgoForge's Firestore usage is intentionally tiny: one document per signed-in
// user, holding a manual cloud backup of their local UserProgress blob (see
// src/lib/cloudBackup.ts and the AlgoForge project's firebase-auth-plan.md).
// There is no other collection, no cross-user reads, and no admin/shared data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/backup/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
